#version 450
#extension GL_GOOGLE_include_directive : enable

#include "constants.glsl"
#include "bone_common.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer BoneMetaBuf { BoneMeta metas[]; };
layout(std430, set = 0, binding = 1) readonly buffer PlaybackBuf { PlaybackState pbs[]; };
layout(std430, set = 0, binding = 6) readonly buffer LocalsBuf { mat4 locals[]; };
layout(std430, set = 0, binding = 7) writeonly buffer PaletteBuf { mat4 palette[]; };
layout(std430, set = 0, binding = 8) readonly buffer InverseBindBuf { mat4 inverseBinds[]; }; 

layout(push_constant) uniform SkinningParams { uint totalThreads; uint playbackCount; } pc;

const uint MAX_DEPTH = 256U; 

void main()
{
    uint threadId = gl_GlobalInvocationID.x;
    if (threadId >= pc.totalThreads) return;

    int instId = -1;
    uint localBone = 0;
    for (uint i = 0; i < pc.playbackCount; ++i) 
    {
        if (threadId >= pbs[i].boneOffset && threadId < pbs[i].boneOffset + pbs[i].boneCount) 
        {
            instId = int(i);
            localBone = threadId - pbs[i].boneOffset;
            break;
        }
    }

    if (instId < 0) 
    {
        palette[threadId] = mat4(1.0);
        return;
    }

    PlaybackState p = pbs[instId];
    uint metaId = p.boneMetaOffset + localBone;
    BoneMeta meta = metas[metaId];

    mat4 world = locals[threadId];
    uint parent = meta.parentIndex;
    uint depth = 0;

    while (parent != UINT32_MAX && depth < MAX_DEPTH)
    {
        if (parent < p.boneMetaOffset || parent >= p.boneMetaOffset + p.boneCount) 
        {
            break;
        }

        uint parentLocalBone = parent - p.boneMetaOffset;
        uint parentPaletteIdx = p.boneOffset + parentLocalBone;
        
        world = locals[parentPaletteIdx] * world; 
        parent = metas[parent].parentIndex;
        depth++;
    }

    palette[threadId] = world * inverseBinds[meta.inverseBindIndex];
}